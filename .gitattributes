# Windows batch files need CRLF line endings, whatever the platform of the checkout
*.bat -text

*.7z binary
*.zip binary
*.png binary
*.jpg binary
*.vtf binary
*.mdl binary
*.vvd binary
*.vtx binary
*.phy binary
*.ani binary
# the parts of an archive split by 7-Zip: content.7z.001, content.7z.002 ...
*.[0-9][0-9][0-9] binary
